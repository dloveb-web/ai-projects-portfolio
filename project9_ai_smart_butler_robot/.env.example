# AI智能管家机器人配置文件

# 服务设置
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# 数据存储
DATA_PATH=data
DATABASE_PATH=data/smart_butler.db
KNOWLEDGE_BASE_PATH=data/knowledge_base
REMINDER_STORAGE_PATH=data/reminders
HEALTH_DATA_PATH=data/health_data

# 本地大模型设置
USE_LOCAL_LLM=true
LLM_MODEL_NAME=Qwen/Qwen2-7B-Instruct
LLM_MODEL_PATH=models/
LLM_CONTEXT_LENGTH=4096
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_QUANTIZATION=q4_0

# 语音识别设置
WAKE_WORD=你好管家
ASR_MODEL_NAME=openai/whisper-small
ASR_LANGUAGE=zh
ASR_ENABLE_LOCAL=true

# 语音合成设置
TTS_MODEL_NAME=
TTS_SPEED=1.0
TTS_VOLUME=1.0

# 用户识别设置
FACE_RECOGNITION_ENABLED=true
VOICEPRINT_RECOGNITION_ENABLED=true
FACE_RECOGNITION_THRESHOLD=0.6
VOICEPRINT_THRESHOLD=0.7

# 人格设置
DEFAULT_PERSONALITY=elderly
PERSONALITY_Elderly_SPEED=0.8
PERSONALITY_Efficient_SPEED=1.0
PERSONALITY_Fun_SPEED=1.2

# 情绪识别设置
EMOTION_RECOGNITION_ENABLED=false
EMOTION_MODEL_NAME=
EMOTION_RESPONSE_ENABLED=true

# 健康监测设置
HEALTH_MONITORING_ENABLED=true
TEMPERATURE_SENSOR_ENABLED=true
BREATHING_MONITORING_ENABLED=true
HEALTH_DATA_RETENTION_DAYS=90

# 智能家居控制
HOME_CONTROL_ENABLED=true
INFRARED_ENABLED=true
WIFI_SMART_ENABLED=true
MATTER_PROTOCOL_ENABLED=false

# 隐私保护
LOCAL_PROCESSING_RATE=0.95
ENCRYPTION_ENABLED=true
PRIVACY_INDICATOR_ENABLED=true
DATA_AUTO_CLEANUP=false

# 紧急联系人
EMERGENCY_CONTACT_1_NAME=
EMERGENCY_CONTACT_1_PHONE=
EMERGENCY_CONTACT_2_NAME=
EMERGENCY_CONTACT_2_PHONE=

# 机器人硬件
ROBOT_MOBILE=true
OBSTACLE_AVOIDANCE_ENABLED=true
AUTO_DOCKING_ENABLED=true
BATTERY_CAPACITY=5000

# 日志
LOG_LEVEL=INFO
LOG_PATH=logs/

