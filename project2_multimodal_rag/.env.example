# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Document Storage
DOCUMENT_STORAGE_PATH=data/documents
DATABASE_PATH=data/documents.db

# Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_VECTOR_SEARCH=true
HF_HUB_TIMEOUT=300
HF_HUB_DOWNLOAD_TIMEOUT=300

# LayoutLM Settings
INIT_LAYOUTLM=true
LAYOUTLM_MODEL_NAME=microsoft/layoutlmv3-base
LAYOUTLM_LOAD_TIMEOUT=600

# Retriever Settings
TOP_K_RESULTS=5
BM25_WEIGHT=0.6
VECTOR_WEIGHT=0.4

# Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100

# OCR Settings
OCR_DEFAULT_LANG=chi_sim+eng
OCR_TIMEOUT=5

# LLM Settings
USE_HYDE=true
TEMPERATURE=0.1
DASHSCOPE_API_KEY=your_api_key

# File Settings
# SUPPORTED_EXTENSIONS: pdf,docx,doc,png,jpg,jpeg,txt,text
# MAX_FILE_SIZE: 52428800 (50MB)
